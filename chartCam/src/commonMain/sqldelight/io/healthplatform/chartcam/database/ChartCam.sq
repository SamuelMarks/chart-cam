import kotlin.Boolean;

/**
 * Generic Resource Entity that mimics the FHIR Engine SDK local database structure.
 */
CREATE TABLE IF NOT EXISTS ResourceEntity (
    resourceId TEXT NOT NULL,
    resourceType TEXT NOT NULL,
    serializedResource TEXT NOT NULL,
    lastUpdated TEXT NOT NULL,
    PRIMARY KEY (resourceType, resourceId)
);

/**
 * Index table for String SearchParams.
 */
CREATE TABLE IF NOT EXISTS StringIndexEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    resourceType TEXT NOT NULL,
    resourceId TEXT NOT NULL,
    indexName TEXT NOT NULL,
    indexValue TEXT NOT NULL,
    FOREIGN KEY(resourceType, resourceId) REFERENCES ResourceEntity(resourceType, resourceId) ON DELETE CASCADE
);

/**
 * Index table for Token SearchParams.
 */
CREATE TABLE IF NOT EXISTS TokenIndexEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    resourceType TEXT NOT NULL,
    resourceId TEXT NOT NULL,
    indexName TEXT NOT NULL,
    indexSystem TEXT,
    indexValue TEXT NOT NULL,
    FOREIGN KEY(resourceType, resourceId) REFERENCES ResourceEntity(resourceType, resourceId) ON DELETE CASCADE
);

/**
 * Index table for Reference SearchParams.
 */
CREATE TABLE IF NOT EXISTS ReferenceIndexEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    resourceType TEXT NOT NULL,
    resourceId TEXT NOT NULL,
    indexName TEXT NOT NULL,
    indexValue TEXT NOT NULL,
    FOREIGN KEY(resourceType, resourceId) REFERENCES ResourceEntity(resourceType, resourceId) ON DELETE CASCADE
);

/**
 * Index table for Date SearchParams.
 */
CREATE TABLE IF NOT EXISTS DateIndexEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    resourceType TEXT NOT NULL,
    resourceId TEXT NOT NULL,
    indexName TEXT NOT NULL,
    indexValue TEXT NOT NULL,
    FOREIGN KEY(resourceType, resourceId) REFERENCES ResourceEntity(resourceType, resourceId) ON DELETE CASCADE
);

insertResource:
INSERT OR REPLACE INTO ResourceEntity(resourceId, resourceType, serializedResource, lastUpdated)
VALUES (?, ?, ?, ?);

getResourceById:
SELECT * FROM ResourceEntity WHERE resourceType = ? AND resourceId = ?;

deleteResourceById:
DELETE FROM ResourceEntity WHERE resourceType = ? AND resourceId = ?;

getAllResourcesByType:
SELECT * FROM ResourceEntity WHERE resourceType = ?;

insertStringIndex:
INSERT INTO StringIndexEntity(resourceType, resourceId, indexName, indexValue)
VALUES (?, ?, ?, ?);

insertTokenIndex:
INSERT INTO TokenIndexEntity(resourceType, resourceId, indexName, indexSystem, indexValue)
VALUES (?, ?, ?, ?, ?);

insertReferenceIndex:
INSERT INTO ReferenceIndexEntity(resourceType, resourceId, indexName, indexValue)
VALUES (?, ?, ?, ?);

insertDateIndex:
INSERT INTO DateIndexEntity(resourceType, resourceId, indexName, indexValue)
VALUES (?, ?, ?, ?);

deleteStringIndices:
DELETE FROM StringIndexEntity WHERE resourceType = ? AND resourceId = ?;

deleteTokenIndices:
DELETE FROM TokenIndexEntity WHERE resourceType = ? AND resourceId = ?;

deleteReferenceIndices:
DELETE FROM ReferenceIndexEntity WHERE resourceType = ? AND resourceId = ?;

deleteDateIndices:
DELETE FROM DateIndexEntity WHERE resourceType = ? AND resourceId = ?;

searchResourcesByString:
SELECT r.* FROM ResourceEntity r
INNER JOIN StringIndexEntity s ON r.resourceType = s.resourceType AND r.resourceId = s.resourceId
WHERE r.resourceType = ? AND s.indexName = ? AND s.indexValue LIKE ('%' || :query || '%');

searchResourcesByToken:
SELECT r.* FROM ResourceEntity r
INNER JOIN TokenIndexEntity t ON r.resourceType = t.resourceType AND r.resourceId = t.resourceId
WHERE r.resourceType = ? AND t.indexName = ? AND (t.indexSystem = :system OR :system IS NULL) AND t.indexValue = ?;

searchResourcesByReference:
SELECT r.* FROM ResourceEntity r
INNER JOIN ReferenceIndexEntity ref ON r.resourceType = ref.resourceType AND r.resourceId = ref.resourceId
WHERE r.resourceType = ? AND ref.indexName = ? AND ref.indexValue = ?;

searchResourcesByDate:
SELECT r.* FROM ResourceEntity r
INNER JOIN DateIndexEntity d ON r.resourceType = d.resourceType AND r.resourceId = d.resourceId
WHERE r.resourceType = ? AND d.indexName = ? AND d.indexValue = ?;

searchResourcesByReferenceDesc:
SELECT r.* FROM ResourceEntity r
INNER JOIN ReferenceIndexEntity ref ON r.resourceType = ref.resourceType AND r.resourceId = ref.resourceId
WHERE r.resourceType = ? AND ref.indexName = ? AND ref.indexValue = ?
ORDER BY r.lastUpdated DESC;

getAllResourcesByTypeDesc:
SELECT * FROM ResourceEntity WHERE resourceType = ? ORDER BY lastUpdated DESC;


/**
 * Table for tracking local changes for Sync Engine
 */
CREATE TABLE IF NOT EXISTS LocalChangeEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    resourceType TEXT NOT NULL,
    resourceId TEXT NOT NULL,
    timestamp TEXT NOT NULL,
    type TEXT NOT NULL, -- INSERT, UPDATE, DELETE
    payload TEXT NOT NULL,
    versionId TEXT -- For ETag tracking
);

insertLocalChange:
INSERT INTO LocalChangeEntity(resourceType, resourceId, timestamp, type, payload, versionId)
VALUES (?, ?, ?, ?, ?, ?);

getAllLocalChanges:
SELECT * FROM LocalChangeEntity ORDER BY id ASC;

deleteLocalChange:
DELETE FROM LocalChangeEntity WHERE id = ?;

deleteLocalChangesForResource:
DELETE FROM LocalChangeEntity WHERE resourceType = ? AND resourceId = ?;

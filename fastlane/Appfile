# Android Configuration
json_key_file("api-key.json") # Path to the service account json for Play Store
package_name("io.healthplatform.chartcam") # Android Application ID

# iOS Configuration
app_identifier("io.healthplatform.chartcam") # The bundle identifier of your app
apple_id(ENV["APPLE_ID"]) # Your Apple email address

# Team Selection
team_id(ENV["APPLE_TEAM_ID"]) # Developer Portal Team ID
itc_team_id(ENV["APPLE_ITC_TEAM_ID"]) # App Store Connect Team ID